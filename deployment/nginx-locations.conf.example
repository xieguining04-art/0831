# Merge into the existing server {} for this domain; do not create duplicate
# location blocks. Configure root, server_name and HTTPS in your own panel.
# Example root only: /www/wwwroot/tengyodalogistics-new
index index.html;

location / {
    try_files $uri $uri/ =404;
    add_header Cache-Control "no-cache" always;
}

# Versioned build filenames can be cached for a long time.
location ^~ /assets/ {
    try_files $uri =404;
    add_header Cache-Control "public, max-age=31536000, immutable";
}

# Keep the serialized static app payloads; do not route them to index.html.
location ~ \.rsc$ {
    types { }
    default_type text/x-component;
    try_files $uri =404;
    add_header Cache-Control "no-cache" always;
}

error_page 404 /404.html;
location = /404.html {
    internal;
    add_header Cache-Control "no-store" always;
}

location ~ /\.(?!well-known(?:/|$)) {
    deny all;
}
